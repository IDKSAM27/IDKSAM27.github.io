{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=20.9.0 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "check:deps": "node scripts/check-dependency-contract.mjs",
    "predev": "npm run check:deps",
    "prebuild": "npm run check:deps",
    "build": "next build --webpack && opennextjs-cloudflare build --skipBuild",
    "build:next": "next build --webpack",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint .",
    "test:docs": "node --test scripts/engineering-content.test.mjs",
    "verify": "npm run check:deps && npm run test:docs && tsc --noEmit && npm run lint",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "deploy": "npm run build && opennextjs-cloudflare deploy",
    "upload": "npm run build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@fontsource/bbh-sans-hegarty": "5.2.1",
    "@gsap/react": "2.1.2",
    "@next/third-parties": "16.2.12",
    "@opennextjs/cloudflare": "1.20.2",
    "framer-motion": "12.38.0",
    "fumadocs-core": "16.14.0",
    "fumadocs-mdx": "15.2.2",
    "fumadocs-ui": "16.14.0",
    "gray-matter": "2.0.1",
    "gsap": "3.13.0",
    "highlight.js": "11.11.1",
    "lucide-react": "1.28.0",
    "mermaid": "11.16.0",
    "next": "16.2.12",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.5.0",
    "rehype-highlight": "7.0.2",
    "rehype-stringify": "10.0.1",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "remark-html": "16.0.1",
    "remark-rehype": "11.1.2",
    "simple-icons": "16.28.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.19",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.4.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "postcss": "8.5.25",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.118.0"
  }
}
